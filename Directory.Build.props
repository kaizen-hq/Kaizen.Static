<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Nothing in this repo is published as a native AOT app. The libraries themselves are trim/AOT-annotated (see src/Directory.Build.props). -->
    <PublishAot>false</PublishAot>
    <!-- One shared version for all three packages; the publish workflow overrides it from the tag (v0.1.0 -> 0.1.0). -->
    <Version>0.1.0</Version>
    <Authors>Kaizenio, Inc.</Authors>
    <Company>Kaizenio, Inc.</Company>
    <Copyright>Copyright (c) 2026 Kaizenio, Inc.</Copyright>
  </PropertyGroup>
</Project>
