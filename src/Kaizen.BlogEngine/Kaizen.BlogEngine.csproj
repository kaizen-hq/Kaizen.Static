<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KaizenIO.BlogEngine</PackageId>
    <PackageTags>blazor;ssr;markdown;blog;front-matter;static-site;kaizen</PackageTags>
    <Description>Kaizen.BlogEngine: Markdig + YamlDotNet post service (YAML front matter) for Blazor SSR.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="YamlDotNet" />
    <!-- Source generator only: generates FrontMatterYamlContext at build time; not a runtime dependency of the package. -->
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" PrivateAssets="all" />
  </ItemGroup>
</Project>
